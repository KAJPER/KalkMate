# Serwer posredniczacy KalkMate (np. ca.kalkmate.pl) — sam nginx, bez aplikacji
# i bez bazy. Przekazuje TYLKO /api/device/solve do serwera glownego
# (Mediolan) po stalym polaczeniu keep-alive. Kalkulator wybiera ten serwer
# sam, gdy jest szybszy (src/server_select.h). Instalacja: install-edge.sh.
# __EDGE_HOST__ / __ORIGIN_IP__ podmienia skrypt.

upstream kalkmate_origin {
    server __ORIGIN_IP__:443;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __EDGE_HOST__;

    # Odnawianie certyfikatu Let's Encrypt (certbot --webroot).
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://kalkmate.pl$request_uri; }
}

server {
    # "listen ... http2" (a nie "http2 on;") — dziala tez na nginx < 1.25 (Ubuntu 22.04/24.04).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __EDGE_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__EDGE_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__EDGE_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Zdjecie zadania ~200 KB; zapas.
    client_max_body_size 2m;

    location = /api/device/solve {
        limit_except POST { deny all; }

        proxy_pass https://kalkmate_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Serwer glowny widzi zwykle zapytanie do kalkmate.pl.
        proxy_set_header Host kalkmate.pl;
        proxy_ssl_server_name on;
        proxy_ssl_name kalkmate.pl;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_session_reuse on;
        # Prawdziwe IP kalkulatora (nadpisuje to, co przyslal klient) —
        # Mediolan ufa temu naglowkowi tylko od IP tego serwera (milan-realip.conf).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Kalkulator czeka do 65 s (_SOL_HTTP_TIMEOUT_MS) — tu wiecej.
        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
        proxy_request_buffering on;
        proxy_buffering on;
    }

    # Wszystko inne (strona, panel, admin) — tylko przez kalkmate.pl.
    location / { return 301 https://kalkmate.pl$request_uri; }
}
