# Drukarka fiskalna POSNET w sieci lokalnej (adres i port z menu drukarki:
# Konfiguracja -> Konfig. połączeń -> Usługi PC -> Interfejs PC -> TCP/IP).
PRINTER_HOST=192.168.1.50
PRINTER_PORT=6666
# Strona kodowa ustawiona w drukarce (Windows-1250 / Latin 2 -> iso8859_2).
PRINTER_ENCODING=cp1250
PRINTER_TIMEOUT=15

# BEZPIECZNIK: 0 = agent odmawia druku, gdy drukarka jest w trybie FISKALNYM.
# Zmień na 1 dopiero po testach na urządzeniu niefiskalnym/szkoleniowym.
FISCAL_ALLOW_REAL=0

# Lokalne API (POST /receipts itd.) — Bearer token.
AGENT_API_TOKEN=zmien-mnie-na-losowy-ciag
AGENT_DB=/var/lib/kalkmate-fiscal-agent/agent.db

# Platforma (kalkmate.pl). Ten sam token co FISCAL_AGENT_TOKEN na serwerze.
PLATFORM_URL=https://kalkmate.pl
PLATFORM_AGENT_TOKEN=zmien-mnie-na-losowy-ciag-2
POLL_INTERVAL=10
STATUS_INTERVAL=60
